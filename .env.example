# Copia de referencia de las variables de entorno. NO pongas aquí claves reales:
# las de verdad van en Vercel → Settings → Environment Variables (y, para probar en tu ordenador, en .env.local).

# --- Web (públicas): las crea la integración de Supabase en Vercel ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=tu_clave_anon

# --- Servidor (secretas): nunca llegan al navegador ---
# SUPABASE_SERVICE_ROLE_KEY=           # la crea la integración de Supabase
# DONACIONES_ACTIVAS=false             # true solo cuando todo lo de abajo esté configurado
# DONACIONES_ENTIDAD=                  # nombre legal de la entidad que recibe las donaciones
# STRIPE_SECRET_KEY=                   # sk_test_… para probar, sk_live_… para cobrar de verdad
# STRIPE_WEBHOOK_SECRET=               # whsec_… del endpoint /api/donaciones/webhook
# DONACIONES_PRIVACIDAD_URL=           # opcional: https://… política de privacidad de la entidad
# DONACIONES_MONEDAS=eur,usd,pen       # opcional
# SITIO_URL=https://hampatuayllu.vercel.app   # opcional
